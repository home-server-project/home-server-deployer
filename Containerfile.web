FROM docker.io/library/golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN go mod tidy
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/deployer-web ./cmd/deployer-web

FROM scratch
COPY --from=build /out/deployer-web /deployer-web
COPY LICENSE /usr/share/licenses/home-server-deployer/LICENSE
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/home-server-deployer/THIRD_PARTY_NOTICES.md
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/deployer-web"]
